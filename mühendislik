<!doctype html>
<html lang="tr"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Engineering Quest</title>
<style>
:root{--bg:#0f1317;--pn:#171d23;--ln:#252d35;--tx:#e6edf3;--mu:#8b98a5;--ac:#2dd4bf;--wa:#f59e0b;--er:#f87171;color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--tx);font:15px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}
#app{display:flex;min-height:100vh}
nav{width:230px;background:var(--pn);border-right:1px solid var(--ln);padding:12px 8px;transition:width .2s;flex-shrink:0}
nav.c{width:56px}nav.c .lb{display:none}
nav button{display:flex;gap:10px;width:100%;align-items:center;background:none;border:0;color:var(--mu);padding:9px 10px;border-radius:8px;cursor:pointer;font:inherit;text-align:left}
nav button:hover{background:#1e262d;color:var(--tx)}nav button.on{background:#12302d;color:var(--ac)}
button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:2px solid var(--ac);outline-offset:2px}
main{flex:1;padding:24px;max-width:1100px;min-width:0}
h1{font-size:22px;margin:0 0 16px}h2{font-size:16px;margin:0 0 10px}
.g{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
.cd{background:var(--pn);border:1px solid var(--ln);border-radius:12px;padding:16px}
.mu{color:var(--mu);font-size:13px}.ac{color:var(--ac)}
.bar{height:8px;background:var(--ln);border-radius:6px;overflow:hidden;margin:8px 0}.bar i{display:block;height:100%;background:var(--ac);transition:width .4s}
.bt{background:var(--ac);color:#04201d;border:0;border-radius:8px;padding:8px 14px;font:inherit;font-weight:600;cursor:pointer}
.bt.s{background:#1e262d;color:var(--tx);border:1px solid var(--ln)}.bt.d{background:none;color:var(--er);border:1px solid var(--er)}
input,textarea,select{width:100%;background:#0f1317;color:var(--tx);border:1px solid var(--ln);border-radius:8px;padding:8px 10px;font:inherit}
textarea{min-height:240px;resize:vertical;font-family:ui-monospace,Menlo,monospace;font-size:14px}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.row>*{flex:0 1 auto}
.li{padding:9px 10px;border-radius:8px;cursor:pointer;border:1px solid transparent}.li:hover{background:#1e262d}.li.on{border-color:var(--ac)}
.tag{display:inline-block;background:#12302d;color:var(--ac);border-radius:10px;padding:1px 8px;font-size:12px;margin-right:4px}
.bars{display:flex;gap:6px;align-items:flex-end;height:70px}.bars div{flex:1;background:var(--ac);border-radius:3px 3px 0 0;min-height:2px}
.ok{color:var(--ac)}.pv h3,.pv h4{margin:8px 0 4px}.pv li{margin-left:18px}
#toast{position:fixed;right:16px;bottom:16px;display:flex;flex-direction:column;gap:8px;z-index:9}
#toast div{background:#1e262d;border:1px solid var(--ac);padding:10px 14px;border-radius:8px}#toast .e{border-color:var(--er)}
.two{display:grid;grid-template-columns:280px 1fr;gap:14px}.cd{transition:border-color .16s,transform .16s}.cd:hover{border-color:#34434c}button{transition:filter .15s,transform .15s}button:hover{filter:brightness(1.08)}button:active{transform:translateY(1px)}a{overflow-wrap:anywhere}::selection{background:#2dd4bf55}@media(max-width:760px){#app{display:block}nav{width:100%;display:flex;gap:4px;overflow-x:auto;border-right:0;border-bottom:1px solid var(--ln);padding:8px}nav button{width:auto;white-space:nowrap;flex-shrink:0}nav .lb{display:inline!important}nav.c{width:100%}nav.c .lb{display:inline!important}main{padding:16px 12px}.g{grid-template-columns:1fr!important}.two{grid-template-columns:1fr}textarea{min-height:180px}}
</style></head><body>
<div id="app"><nav id="nav" aria-label="Ana menü"></nav><main id="main"></main></div><div id="toast" role="status" aria-live="polite"></div>
<script>
const K='eq_v1';
const PAGES=[['dash','▦','Panel',1],['lib','▤','Akademik Kütüphane',2],['notes','✎','Notlar ve Bilgi Bankası',1],['lang','文','Dil Akademisi',3],['dict','Ⓓ','Sözlük',3],['cards','◫','Kartlar ve Tekrar',3],['shop','⚙','Mühendislik Atölyesi',4],['proj','◈','Projeler ve Günlük',2],['quest','⚔','Görevler ve Yetenek Ağacı',1],['rewards','🎁','Ödül Havuzu',1],['stats','≋','İstatistik ve Ayarlar',1]];
const PLANNED={lib:'PDF yükleme, PDF.js okuyucu, vurgular, okuma konumu',lang:'İngilizce A2–B1 ve Almanca A1 alıştırmaları',dict:'Türkçe/İngilizce/Almanca mühendislik terimleri',cards:'Aralıklı tekrar (SM-2 benzeri) ve kart desteleri',shop:'Birim çevirici, gerilme/yoğunluk/ısı hesaplayıcıları (testli)',proj:'Proje çalışma alanı ve araştırma günlüğü'};
let S=load(),page=localStorage.getItem('eq_page')||'dash',sel=null,prev=false,q='',dictMode='tech',langDictLang='en';
function init(){return{notes:[],xp:[],sessions:[],cards:[],dict:[],langWords:[],grammarDone:{},langLog:[],essays:[],drafts:{},docs:[],myref:[],timer:null,collapsed:false,articleDone:{},rewardClaims:{},customRewards:[],projects:[],dailyTasks:[],projectLogs:[]}}
function load(){try{const s=JSON.parse(localStorage.getItem(K));return s&&Array.isArray(s.notes)?{...init(),...s}:init()}catch(e){return init()}}
function save(){try{localStorage.setItem(K,JSON.stringify(S));return true}catch(e){toast('Kayıt başarısız: depolama kullanılamıyor.',1);return false}}
const $=s=>document.querySelector(s);
const esc=t=>String(t).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const pad=n=>String(n).padStart(2,'0');
const day=d=>{d=d||new Date();return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())};
const weekStart=()=>{const d=new Date();d.setDate(d.getDate()-((d.getDay()+6)%7));return day(d)};
const words=t=>t.trim().split(/\s+/).filter(Boolean).length;
function toast(m,e){const d=document.createElement('div');if(e)d.className='e';d.textContent=m;$('#toast').append(d);setTimeout(()=>d.remove(),3500)}
// Ek dosyalar IndexedDB'de tutulur; büyük PDF'ler localStorage kotasını doldurmaz.
let _eqDbPromise;function eqDb(){if(_eqDbPromise)return _eqDbPromise;_eqDbPromise=new Promise((resolve,reject)=>{const r=indexedDB.open('EngineeringQuestFiles',1);r.onupgradeneeded=()=>{if(!r.result.objectStoreNames.contains('files'))r.result.createObjectStore('files',{keyPath:'id'})};r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error)});return _eqDbPromise}
async function eqFilePut(id,file){const db=await eqDb();return new Promise((resolve,reject)=>{const tx=db.transaction('files','readwrite');tx.objectStore('files').put({id,name:file.name,type:file.type||'application/octet-stream',blob:file});tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error)})}
async function eqFileGet(id){const db=await eqDb();return new Promise((resolve,reject)=>{const r=db.transaction('files').objectStore('files').get(id);r.onsuccess=()=>resolve(r.result||null);r.onerror=()=>reject(r.error)})}
async function eqFileDel(id){const db=await eqDb();return new Promise((resolve,reject)=>{const tx=db.transaction('files','readwrite');tx.objectStore('files').delete(id);tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error)})}
function eqFileOpen(id,download=false){eqFileGet(id).then(f=>{if(!f)return toast('Dosya bulunamadı; tarayıcı verileri silinmiş olabilir.',1);const u=URL.createObjectURL(f.blob);const a=document.createElement('a');a.href=u;if(download){a.download=f.name;a.click()}else{a.target='_blank';a.rel='noopener';a.click()}setTimeout(()=>URL.revokeObjectURL(u),60000)}).catch(()=>toast('Dosya açılamadı.',1))}
// XP + level
const total=()=>S.xp.reduce((a,e)=>a+e.amt,0);
const lvlAt=x=>Math.floor(Math.sqrt(x/100))+1; // level n starts at 100*(n-1)^2 XP
const lvlStart=l=>100*(l-1)*(l-1);
function award(key,amt,label){if(S.xp.some(e=>e.key===key))return false;S.xp.push({key,amt,label,ts:Date.now(),day:day()});return true}
// Quests: verified from stored activity
const inDay=ts=>day(new Date(ts))===day(), inWeek=ts=>day(new Date(ts))>=weekStart();
const minutes=f=>Math.floor(S.sessions.filter(s=>f(s.end)).reduce((a,s)=>a+s.min,0));
const QUESTS=[
{id:'d-note',t:'Günlük',n:'En az 20 kelimelik bir not yaz',xp:20,chk:()=>{const c=S.notes.filter(n=>inDay(n.created)&&words(n.body)>=20).length;return[c>=1,c+'/1']}},
{id:'d-time',t:'Günlük',n:'15 dakika ölçülmüş çalışma (zamanlayıcı)',xp:25,chk:()=>{const m=minutes(inDay);return[m>=15,m+'/15 dk']}},
{id:'d-tag',t:'Günlük',n:'Etiketli bir notu sabitle',xp:10,chk:()=>{const c=S.notes.filter(n=>n.pinned&&n.tags.length).length;return[c>=1,c+'/1']}},
{id:'d-cards',t:'Günlük',n:'10 kart tekrar et',xp:20,chk:()=>{const c=S.cards.reduce((a,x)=>a+x.hist.filter(h=>inDay(h.ts)).length,0);return[c>=10,Math.min(c,10)+'/10']}},
{id:'d-dict',t:'Günlük',n:'Sözlüğe tanımlı 1 terim ekle',xp:15,chk:()=>{const c=S.dict.filter(e=>inDay(e.created)&&e.def&&e.def.length>=10).length;return[c>=1,Math.min(c,1)+'/1']}},
{id:'d-lang',t:'Günlük',n:'1 dil alıştırmasını geç (≥%60)',xp:15,chk:()=>{const c=S.langLog.filter(l=>inDay(l.ts)&&l.score/l.total>=.6).length;return[c>=1,Math.min(c,1)+'/1']}},
{id:'d-essay',t:'Günlük',n:'Günün yazma görevini tamamla (Dil Akademisi)',xp:30,chk:()=>{const c=S.essays.filter(e=>inDay(e.ts)).length;return[c>=1,Math.min(c,1)+'/1']}},
{id:'d-calc',t:'Günlük',n:'Atölyede 1 mühendislik hesabı yap',xp:15,chk:()=>{const c=S.xp.filter(e=>e.key.startsWith('calc:')&&e.day===day()).length;return[c>=1,Math.min(c,1)+'/1']}},
{id:'d-read',t:'Günlük',n:'Bir makalede 3 sayfa oku',xp:20,chk:()=>{const c=S.xp.some(e=>e.key.startsWith('read:')&&e.day===day());return[c,c?'1/1':'0/1']}},
{id:'d-article',t:'Günlük',n:'Günün dil makalesini tam puanla',xp:25,chk:()=>{const c=Object.entries(S.articleDone||{}).some(([k,v])=>k.startsWith(day()+':')&&v.score===3);return[c,c?'1/1':'0/1']}},
{id:'w-notes',t:'Haftalık',n:'Bu hafta 5 anlamlı not (≥20 kelime)',xp:60,chk:()=>{const c=S.notes.filter(n=>inWeek(n.created)&&words(n.body)>=20).length;return[c>=5,Math.min(c,5)+'/5']}},
{id:'w-time',t:'Haftalık',n:'Bu hafta 90 dakika çalışma',xp:80,chk:()=>{const m=minutes(inWeek);return[m>=90,Math.min(m,90)+'/90 dk']}}];
const qkey=q=>q.id+':'+(q.t==='Günlük'?day():weekStart());
function evalAll(){let ch=false;for(const n of S.notes)if(words(n.body)>=20&&award('note:'+n.id,10,'Not kaydedildi: '+n.title)){ch=true;toast('+10 XP · not')}
for(const q of QUESTS)if(q.chk()[0]&&award(qkey(q),q.xp,'Görev: '+q.n)){ch=true;toast('Görev tamamlandı! +'+q.xp+' XP')}
for(const nd of nodes())if(nd.st==='done'&&award('node:'+nd.id,15,'Yetenek: '+nd.nm)){ch=true;toast('Yetenek açıldı: '+nd.nm+' +15 XP')}
if(ch)save()}
function streak(){const ds=new Set([...S.xp.map(e=>e.day),...S.sessions.map(s=>day(new Date(s.end)))]);let n=0,d=new Date();if(!ds.has(day(d)))d.setDate(d.getDate()-1);while(ds.has(day(d))){n++;d.setDate(d.getDate()-1)}return n}
// render
function nav(){$('#nav').className=S.collapsed?'c':'';$('#nav').innerHTML='<button id="col" aria-label="Menüyü daralt">☰<span class="lb">Engineering Quest</span></button>'+PAGES.map(p=>`<button data-p="${p[0]}" class="${p[0]===page?'on':''}" title="${p[2]}">${p[1]}<span class="lb">${p[2]}</span></button>`).join('');
$('#col').onclick=()=>{S.collapsed=!S.collapsed;save();nav()};
$('#nav').insertAdjacentHTML('beforeend',"<button id='qa' style='color:#2dd4bf;margin-top:10px;border:1px dashed #2dd4bf' title='Hızlı Ekle'>＋<span class='lb'>Hızlı Ekle</span></button>");
$('#qa').onclick=()=>qa('c');
document.querySelectorAll('nav [data-p]').forEach(b=>b.onclick=()=>{page=b.dataset.p;localStorage.setItem('eq_page',page);render()})}
function render(){evalAll();nav();const m=$('#main');({dash,notes,quest,stats,cards,dict,lang,shop,lib,rewards,proj}[page]||planned)(m)}

// Projects + daily task workspace. Data is stored locally with the rest of S.
function proj(m){
  S.projects ||= []; S.dailyTasks ||= []; S.projectLogs ||= [];
  const today=day();
  const active=S.projects.filter(p=>p.status!=='done');
  const tasksToday=S.dailyTasks.filter(t=>t.date===today).sort((a,b)=>({Yüksek:0,Orta:1,Düşük:2}[a.priority]??1)-({Yüksek:0,Orta:1,Düşük:2}[b.priority]??1));
  const projectTasks=id=>S.dailyTasks.filter(t=>t.projectId===id);
  const projectPct=p=>{const ts=projectTasks(p.id);return ts.length?Math.round(ts.filter(t=>t.done).length/ts.length*100):(p.status==='done'?100:0)};
  const projectName=id=>S.projects.find(p=>p.id===id)?.title||'Bağımsız görev';
  const projectOptions=(chosen='')=>'<option value="">Bağımsız görev</option>'+S.projects.filter(p=>p.status!=='done').map(p=>`<option value="${p.id}" ${p.id===chosen?'selected':''}>${esc(p.title)}</option>`).join('');
  m.innerHTML=`<h1>Projeler ve Günlük Görevler</h1>
  <p class="mu" style="margin-top:-8px">Büyük hedeflerini projelere böl, bugün yapacağın işleri seç ve tamamladıkça ilerlemeni takip et. Görevler ve proje kayıtları bu tarayıcıda saklanır.</p>
  <div class="g" style="margin-bottom:14px"><div class="cd"><div class="mu">Aktif projeler</div><div style="font-size:28px;font-weight:700">${active.length}</div></div><div class="cd"><div class="mu">Bugünkü görevler</div><div style="font-size:28px;font-weight:700">${tasksToday.length}</div></div><div class="cd"><div class="mu">Tamamlanan bugün</div><div style="font-size:28px;font-weight:700">${tasksToday.filter(t=>t.done).length}/${tasksToday.length}</div></div><div class="cd"><div class="mu">Bugünkü planlı süre</div><div style="font-size:28px;font-weight:700">${tasksToday.filter(t=>!t.done).reduce((n,t)=>n+(+t.minutes||0),0)} <span style="font-size:14px">dk kaldı</span></div></div></div>
  <div class="g" style="align-items:start"><section class="cd"><h2>＋ Yeni proje</h2><form id="projectForm"><label class="mu" for="projectTitle">Proje adı</label><input id="projectTitle" maxlength="100" required placeholder="Örn. Termodinamik öğrenme dosyası"><label class="mu" for="projectDesc" style="display:block;margin-top:8px">Amaç ve beklenen sonuç</label><textarea id="projectDesc" style="min-height:90px" maxlength="2000" placeholder="Bu projeyi neden yapıyorsun, sonunda ne elde edeceksin?"></textarea><div class="row" style="margin-top:8px"><div style="flex:1;min-width:140px"><label class="mu" for="projectCat">Kategori</label><select id="projectCat"><option>Üniversite</option><option>Dil öğrenme</option><option>Mühendislik</option><option>Kişisel gelişim</option><option>Araştırma</option><option>Diğer</option></select></div><div style="flex:1;min-width:140px"><label class="mu" for="projectTarget">Hedef tarih</label><input id="projectTarget" type="date" min="${today}"></div></div><button class="bt" style="margin-top:10px" type="submit">Projeyi oluştur</button></form></section>
  <section class="cd"><h2>＋ Günlük görev ekle</h2><form id="taskForm"><label class="mu" for="taskTitle">Görev</label><input id="taskTitle" maxlength="160" required placeholder="Örn. 20 kelime öğren ve tekrar et"><div class="row" style="margin-top:8px"><div style="flex:1;min-width:150px"><label class="mu" for="taskProject">Bağlı proje</label><select id="taskProject">${projectOptions()}</select></div><div style="flex:1;min-width:120px"><label class="mu" for="taskDate">Tarih</label><input id="taskDate" type="date" value="${today}" required></div></div><div class="row" style="margin-top:8px"><div style="flex:1;min-width:120px"><label class="mu" for="taskPriority">Öncelik</label><select id="taskPriority"><option>Yüksek</option><option selected>Orta</option><option>Düşük</option></select></div><div style="flex:1;min-width:120px"><label class="mu" for="taskMinutes">Tahmini süre (dk)</label><input id="taskMinutes" type="number" min="0" max="1440" value="25"></div></div><label class="mu" for="taskNote" style="display:block;margin-top:8px">Küçük not (isteğe bağlı)</label><input id="taskNote" maxlength="300" placeholder="Başlamak için ilk adım…"><button class="bt" style="margin-top:10px" type="submit">Görevi ekle</button></form></section></div>
  <section class="cd" style="margin-top:14px"><div class="row" style="justify-content:space-between"><h2 style="margin:0">Bugünün görevleri</h2><span class="tag">${today}</span></div><div class="bar"><i style="width:${tasksToday.length?Math.round(tasksToday.filter(t=>t.done).length/tasksToday.length*100):0}%"></i></div>${tasksToday.length?tasksToday.map(t=>`<div class="row" style="padding:10px 0;border-bottom:1px solid var(--ln);align-items:start"><input type="checkbox" data-task-done="${t.id}" ${t.done?'checked':''} aria-label="${t.done?'Görevi geri aç':'Görevi tamamla'}" style="width:auto;margin-top:5px"><div style="flex:1;min-width:160px"><div style="${t.done?'text-decoration:line-through;opacity:.65':''}"><b>${esc(t.title)}</b></div><div class="mu">${esc(projectName(t.projectId))} · ${t.minutes||0} dk · <span style="color:${t.priority==='Yüksek'?'var(--wa)':'var(--mu)'}">${esc(t.priority)} öncelik</span></div>${t.note?`<div class="mu">${esc(t.note)}</div>`:''}</div><button class="bt s" data-task-delete="${t.id}" aria-label="Görevi sil">Sil</button></div>`).join(''):'<p class="mu">Bugün için görev yok. Yukarıdan bir görev ekleyebilirsin.</p>'}</section>
  <h2 style="margin-top:20px">Projelerim</h2><div class="g">${S.projects.length?S.projects.slice().sort((a,b)=>(a.status==='done')-(b.status==='done')||b.created-a.created).map(p=>{const ts=projectTasks(p.id),pct=projectPct(p),logs=S.projectLogs.filter(l=>l.projectId===p.id).sort((a,b)=>b.ts-a.ts).slice(0,3);return `<article class="cd"><div class="row" style="justify-content:space-between;align-items:start"><div style="flex:1"><span class="tag">${esc(p.category||'Diğer')}</span><h2 style="margin-top:8px">${esc(p.title)}</h2></div><select data-project-status="${p.id}" aria-label="Proje durumu" style="width:auto;max-width:140px"><option value="active" ${p.status==='active'?'selected':''}>Aktif</option><option value="paused" ${p.status==='paused'?'selected':''}>Beklemede</option><option value="done" ${p.status==='done'?'selected':''}>Tamamlandı</option></select></div><p>${esc(p.description||'Henüz açıklama eklenmedi.')}</p><div class="row" style="justify-content:space-between"><span class="mu">${ts.filter(t=>t.done).length}/${ts.length} görev tamamlandı</span><b>${pct}%</b></div><div class="bar"><i style="width:${pct}%"></i></div><div class="mu">${p.targetDate?'Hedef: '+esc(p.targetDate):'Hedef tarihi belirlenmedi'} · Oluşturuldu: ${esc(p.createdDate||'')}</div><details style="margin-top:10px"><summary>Proje günlüğü ve notları (${logs.length})</summary><form data-log-form="${p.id}" style="margin-top:8px"><textarea name="body" maxlength="3000" style="min-height:75px" required placeholder="Bugün ne ilerledi, ne öğrendin, sıradaki adım ne?"></textarea><button class="bt s" style="margin-top:6px" type="submit">Günlüğe ekle</button></form>${logs.map(l=>`<div style="border-top:1px solid var(--ln);padding:8px 0"><div class="mu">${esc(new Date(l.ts).toLocaleString())}</div><div style="white-space:pre-wrap">${esc(l.body)}</div></div>`).join('')||'<p class="mu">Henüz günlük kaydı yok.</p>'}</details><div class="row" style="margin-top:12px"><button class="bt s" data-project-addtask="${p.id}">＋ Bu projeye görev</button><button class="bt d" data-project-delete="${p.id}">Projeyi sil</button></div></article>`}).join(''):'<div class="cd"><p class="mu">Henüz proje oluşturmadın. İlk projenle uzun vadeli hedefini takip etmeye başlayabilirsin.</p></div>'}</div>
  <section class="cd" style="margin-top:14px"><h2>Yaklaşan ve geciken görevler</h2>${S.dailyTasks.filter(t=>t.date>today&&!t.done||t.date<today&&!t.done).sort((a,b)=>a.date.localeCompare(b.date)).slice(0,12).map(t=>`<div class="row" style="padding:7px 0;border-bottom:1px solid var(--ln)"><span class="tag">${esc(t.date)}</span><span style="flex:1">${esc(t.title)}</span><span class="mu">${esc(projectName(t.projectId))}</span><button class="bt s" data-task-move="${t.id}">Bugüne al</button></div>`).join('')||'<p class="mu">Geciken veya yaklaşan açık görev yok.</p>'}</section>`;
