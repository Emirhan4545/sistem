const any=d.minutes||d.notes||d.reviews||d.calcs||d.docsDone||d.dailyArt||d.projTasks||d.lang.en.n||d.lang.de.n;
const win=stRange?'son '+stRange+' gün':'tüm zamanlar';const cw=stRange?'son '+Math.min(stRange,30)+' gün':'son 30 gün';
