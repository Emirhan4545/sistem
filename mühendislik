function statsData(S,days,now,nDaily){
const pd=n=>String(n).padStart(2,'0');
const dk=ts=>{const x=new Date(ts);return x.getFullYear()+'-'+pd(x.getMonth()+1)+'-'+pd(x.getDate())};
const back=n=>{const x=new Date(now);x.setHours(12,0,0,0);x.setDate(x.getDate()-n);return x};
const todayK=dk(now),sk=days?dk(back(days-1)):'';
const inR=ts=>!days||dk(ts)>=sk;
const sessAll=S.sessions||[],xpAll=S.xp||[],cards=S.cards||[];
const sess=sessAll.filter(s=>inR(s.end));
const minutes=sess.reduce((a,s)=>a+s.min,0);
const notes=(S.notes||[]).filter(n=>inR(n.created)).length;
const revs=[];for(const c of cards)for(const h of (c.hist||[]))if(inR(h.ts))revs.push(h);
const rec=revs.filter(h=>h.q>=1).length;
const xpE=xpAll.filter(e=>inR(e.ts));
const cnt=p=>xpE.filter(e=>e.key.startsWith(p)).length;
const lang={};for(const L of ['en','de']){const a=(S.langLog||[]).filter(l=>l.lang===L&&inR(l.ts));const sc=a.reduce((t,l)=>t+l.score,0),tt=a.reduce((t,l)=>t+l.total,0);lang[L]={n:a.length,acc:tt?Math.round(sc/tt*100):null}}
const allK=new Set([...xpAll.map(e=>dk(e.ts)),...sessAll.map(s=>dk(s.end))]);
const actK=new Set([...xpE.map(e=>dk(e.ts)),...sess.map(s=>dk(s.end)),...(S.notes||[]).filter(n=>inR(n.created)).map(n=>dk(n.created)),...revs.map(h=>dk(h.ts))]);
let span=days;if(!days){const first=[...allK,...(S.notes||[]).map(n=>dk(n.created))].sort()[0];span=first?Math.min(365,Math.round((new Date(todayK+'T12:00:00')-new Date(first+'T12:00:00'))/864e5)+1):0}
const dq=xpAll.filter(e=>{const m=/^d-[a-z-]+:(\d{4}-\d{2}-\d{2})$/.exec(e.key);return m&&(!days||m[1]>=sk)}).length;
const possible=nDaily*span,qdone=Math.min(dq,possible);
const ds=[...allK].sort();let longest=0,run=0,prev=null;for(const k of ds){run=prev&&Math.round((new Date(k+'T12:00:00')-new Date(prev+'T12:00:00'))/864e5)===1?run+1:1;longest=Math.max(longest,run);prev=k}
let cur=0;const c0=back(0);if(!allK.has(todayK))c0.setDate(c0.getDate()-1);while(allK.has(dk(c0))){cur++;c0.setDate(c0.getDate()-1)}
const N=Math.min(days||30,30),keys=[];for(let i=N-1;i>=0;i--)keys.push(dk(back(i)));
const idx=Object.fromEntries(keys.map((k,i)=>[k,i]));const mp=Array(N).fill(0),xpd=Array(N).fill(0),rv=Array(N).fill(0);
for(const s of sessAll){const i=idx[dk(s.end)];if(i!==undefined)mp[i]+=s.min}
for(const e of xpAll){const i=idx[dk(e.ts)];if(i!==undefined)xpd[i]+=e.amt}
for(const c of cards)for(const h of (c.hist||[])){const i=idx[dk(h.ts)];if(i!==undefined)rv[i]++}
const tp={};const add=l=>{l=String(l||'').trim().toLowerCase();if(l)tp[l]=(tp[l]||0)+1};
for(const n of S.notes||[])if(inR(n.created))(n.tags||[]).forEach(add);
for(const d of S.docs||[])if(inR(d.created))(d.tags||[]).forEach(add);
for(const e of S.dict||[])if(inR(e.created||0))add(e.cat);
for(const c of cards)if(inR(c.created))add(c.deck);
const topics=Object.entries(tp).sort((a,b)=>b[1]-a[1]).slice(0,8);
return{minutes,notes,reviews:revs.length,accuracy:revs.length?Math.round(rec/revs.length*100):null,calcs:cnt('calc:'),docsDone:cnt('doc:'),dailyArt:cnt('daily-article:'),projTasks:cnt('project-task:'),lang,activeDays:actK.size,span,qdone,possible,rate:possible?Math.round(qdone/possible*100):null,cur,longest,keys,mp,xpd,rv,topics,xpSum:xpE.reduce((a,e)=>a+e.amt,0)}}
/*STATS-END*/
function svgBars(vals,keys,unit,label){const mx=Math.max(...vals,1),n=vals.length,w=580/n;if(!vals.some(v=>v>0))return `<div class='mu'>Bu aralıkta veri yok.</div>`;
return `<svg viewBox='0 0 600 150' role='img' aria-label='${label}' style='width:100%;height:auto'><text x='4' y='12' fill='var(--mu)' font-size='11'>en yüksek: ${Math.round(mx*10)/10} ${unit}</text>${vals.map((v,i)=>{const h=Math.round(v/mx*100);return `<rect x='${(10+i*w+w*.15).toFixed(1)}' y='${125-h}' width='${(w*.7).toFixed(1)}' height='${v?Math.max(h,2):0}' rx='2' fill='var(--ac)'><title>${keys[i]}: ${Math.round(v*10)/10} ${unit}</title></rect>`}).join('')}<line x1='8' x2='592' y1='125.5' y2='125.5' stroke='var(--ln)'/><text x='10' y='142' fill='var(--mu)' font-size='11'>${keys[0].slice(5)}</text><text x='590' y='142' fill='var(--mu)' font-size='11' text-anchor='end'>${keys[n-1].slice(5)}</text></svg>`}
function statsView(){const d=statsData(S,stRange,Date.now(),QUESTS.filter(q=>q.t==='Günlük').length);
